{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WINEE",
  "version": "1.4.2",
  "identifier": "com.winee.utility",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WINEE",
        "label": "main",
        "fullscreen": false,
        "maximized": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "resizable": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright © 2026 WinOpie Team. All rights reserved.",
    "shortDescription": "Native Windows 11 radial quick-action utility",
    "longDescription": "WINEE is a high-performance productivity radial action menu for Windows 11 with custom themes, gestures, and quick tools.",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "WINEE"
      }
    }
  }
}
